    {
      "name": "Level 4: Complex Scenarios & Multiple Actions",
      "item": [
        {
          "name": "Test VIP Special Offer (Discount + Free Gift)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"cart\": {\n        \"items\": [\n            {\n                \"productId\": \"P-LUXURY\",\n                \"quantity\": 1,\n                \"price\": 5100.00\n            }\n        ]\n    },\n    \"context\": {\n        \"customerId\": \"CUST-VIP1\",\n        \"customerAttributes\": {\n            \"categorieClient\": \"VIP\"\n        }\n    }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/apply",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "apply"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Should apply 10% discount\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.finalTotal).to.eql(4590.00);",
                  "});",
                  "",
                  "pm.test(\"Should add free gift\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.addedItems).to.be.an('array').that.is.not.empty;",
                  "    var freeGift = jsonData.addedItems.find(i => i.productId === 'BIMO_EXTRA');",
                  "    pm.expect(freeGift).to.exist;",
                  "    pm.expect(freeGift.quantity).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
