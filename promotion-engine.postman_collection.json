    {
      "name": "Level 1: Price List & Customer Rules",
      "item": [
        {
          "name": "Apply LOGI FOOD Price List",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"cart\": {\n        \"items\": [\n            {\n                \"productId\": \"BURV1KG\",\n                \"quantity\": 2,\n                \"price\": 60.00\n            },\n            {\n                \"productId\": \"PSUR0200125\",\n                \"quantity\": 1,\n                \"price\": 70.00\n            }\n        ]\n    },\n    \"context\": {\n        \"customerId\": \"LOGI FOOD\",\n        \"customerAttributes\": {\n            \"customerId\": \"LOGI FOOD\"\n        }\n    }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions/apply",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions", "apply"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Price for BURV1KG should be overridden to 45.00\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var item = jsonData.finalCart.items.find(i => i.productId === 'BURV1KG');",
                  "    pm.expect(item.price).to.eql(45.00);",
                  "});",
                  "",
                  "pm.test(\"Final total should be correct (2*45 + 1*53)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.finalTotal).to.eql(143.00);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
