    {
      "name": "Promotion Creation",
      "item": [
        {
          "name": "Create LOGI FOOD Price List",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Price List - LOGI FOOD\",\n    \"priority\": 100,\n    \"exclusive\": true,\n    \"active\": true,\n    \"startDate\": \"{{$isoTimestamp}}\",\n    \"endDate\": \"{{$isoTimestamp}}\",\n    \"rules\": [\n        {\n            \"type\": \"CUSTOMER_ATTRIBUTE\",\n            \"parameters\": \"{\\\"attribute\\\": \\\"customerId\\\", \\\"value\\\": \\\"LOGI FOOD\\\"}\"\n        }\n    ],\n    \"actions\": [\n        {\n            \"type\": \"SET_PRICE\",\n            \"parameters\": \"{\\\"productId\\\": \\\"BURV1KG\\\", \\\"newPrice\\\": 45.00}\"\n        },\n        {\n            \"type\": \"SET_PRICE\",\n            \"parameters\": \"{\\\"productId\\\": \\\"PSUR0200008\\\", \\\"newPrice\\\": 45.00}\"\n        },\n        {\n            \"type\": \"SET_PRICE\",\n            \"parameters\": \"{\\\"productId\\\": \\\"PSUR0200125\\\", \\\"newPrice\\\": 53.00}\"\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Promotion has correct name and priority\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.name).to.eql(\"Price List - LOGI FOOD\");",
                  "    pm.expect(jsonData.priority).to.eql(100);",
                  "});",
                  "",
                  "pm.test(\"Has correct number of price override actions\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.actions.length).to.eql(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
