        {
          "name": "Create Mix & Match Promotion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Mix & Match - 3 Different Pops\",\n    \"priority\": 15,\n    \"exclusive\": false,\n    \"active\": true,\n    \"startDate\": \"{{$isoTimestamp}}\",\n    \"endDate\": \"{{$isoTimestamp}}\",\n    \"rules\": [\n        {\n            \"type\": \"BASKET_COMPOSITION\",\n            \"parameters\": \"{\\\"category\\\": \\\"Pops\\\", \\\"distinctProducts\\\": 3}\"\n        }\n    ],\n    \"actions\": [\n        {\n            \"type\": \"PERCENTAGE_DISCOUNT\",\n            \"parameters\": \"{\\\"percentage\\\": 20.0, \\\"scope\\\": \\\"category\\\", \\\"value\\\": \\\"Pops\\\"}\"\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions"]
