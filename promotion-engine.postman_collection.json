        {
          "name": "Create VIP Special Offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"VIP 5000DH Special - Discount + Free Gift\",\n    \"priority\": 50,\n    \"exclusive\": true,\n    \"active\": true,\n    \"startDate\": \"{{$isoTimestamp}}\",\n    \"endDate\": \"{{$isoTimestamp}}\",\n    \"description\": \"AND\",\n    \"rules\": [\n        {\n            \"type\": \"CUSTOMER_ATTRIBUTE\",\n            \"parameters\": \"{\\\"attribute\\\": \\\"categorieClient\\\", \\\"value\\\": \\\"VIP\\\"}\"\n        },\n        {\n            \"type\": \"TOTAL_AMOUNT\",\n            \"parameters\": \"{\\\"minAmount\\\": 5000}\"\n        }\n    ],\n    \"actions\": [\n        {\n            \"type\": \"PERCENTAGE_DISCOUNT\",\n            \"parameters\": \"{\\\"percentage\\\": 10.0}\"\n        },\n        {\n            \"type\": \"ADD_PRODUCT_FREE\",\n            \"parameters\": \"{\\\"productId\\\": \\\"BIMO_EXTRA\\\", \\\"quantity\\\": 1}\"\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/promotions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "promotions"]
            }
          }
        }
